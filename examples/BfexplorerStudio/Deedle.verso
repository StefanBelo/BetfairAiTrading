      "type": "code",
      "language": "fsharp",
      "source": "#r \u0022nuget: Deedle\u0022\r\n#r \u0022nuget: Deedle.DotNetInteractive\u0022\r\n\r\nopen Deedle\r\n\r\nlet prices =\r\n    frame [ \u0022Open\u0022  =\u003E Series.ofValues [ 100.0; 102.5; 101.0; 103.0 ]\r\n            \u0022Close\u0022 =\u003E Series.ofValues [ 101.5; 101.0; 103.5; 104.0 ]\r\n            \u0022Vol\u0022   =\u003E Series.ofValues [ 12000; 15000; 11000; 14000 ] ]\r\n\r\nprices",
      "outputs": [
        {
          "mimeType": "text/html",
          "content": "\u003Cdiv\u003E\u003Cb\u003EInstalled Packages\u003C/b\u003E\u003Cul\u003E\u003Cli\u003E\u003Cspan\u003EDeedle, 7.0.1\u003C/span\u003E\u003C/li\u003E\u003Cli\u003E\u003Cspan\u003EDeedle.DotNetInteractive, 7.0.1\u003C/span\u003E\u003C/li\u003E\u003C/ul\u003E\u003C/div\u003E"
        },
        {
