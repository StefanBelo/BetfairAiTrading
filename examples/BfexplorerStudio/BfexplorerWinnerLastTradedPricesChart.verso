    },
    {
      "id": "125d6534-77dc-48b3-9208-22fc5483f457",
      "type": "code",
      "language": "fsharp",
      "source": "let toChart (market : Market) = \r\n    match market.Selections |\u003E Seq.tryFind (fun selection -\u003E selection.Status = SelectionStatus.Winner) with\r\n    | Some selection -\u003E\r\n        \r\n        let x, y = \r\n            let startTime = market.MarketInfo.StartTime\r\n            \r\n            selection.PriceTradedHistory.TradedPrices\r\n            |\u003E Seq.map (fun data -\u003E (data.Time - startTime).TotalMinutes, data.Price)\r\n            |\u003E Seq.toList\r\n            |\u003E List.unzip\r\n\r\n        Some (Chart.Line (x, y, Name = selection.Name))\r\n\r\n    | None -\u003E None"
    },
    {
      "id": "dc4772a6-28a0-474b-928c-e34e07e4673a",
      "type": "code",
      "language": "fsharp",
      "source": "let doShowChart (iBfexplorerConsole : IBfexplorerConsole) =\r\n    let closedMarkets = iBfexplorerConsole.OpenMarkets |\u003E List.filter isClosedMarket\r\n\r\n    if not closedMarkets.IsEmpty\r\n    then\r\n        let combinedChartHtml =\r\n            closedMarkets \r\n            |\u003E List.choose toChart\r\n            |\u003E Chart.combine\r\n            |\u003E Chart.withLayout(Layout.init(Width = 1200, Height = 1000))\r\n            |\u003E GenericChart.toEmbeddedHTML\r\n\r\n        let readyHtml =                                                                                                                                                                 \r\n            Regex.Replace(                                           \r\n                combinedChartHtml,\r\n                @\u0022(renderPlotly_\\w\u002B)\\(\\);\u0022,\r\n                \u0022\u0022\u0022var render=$1;if(window.Plotly){render();}else{document.querySelector(\u0027script[src*=\u0022plotly\u0022]\u0027).addEventListener(\u0027load\u0027,render);}\u0022\u0022\u0022)  \r\n\r\n        displayAs \u0022text/html\u0022 readyHtml\r\n    else\r\n        printfn \u0022No markets are closed.\u0022"
    },
    {
      "id": "7732bd82-e8de-4887-9c74-46fdafcc3c7d",
      "type": "code",
      "language": "fsharp",
      "source": "doShowChart (bfexplorerHost :\u003E IBfexplorerConsole)",
