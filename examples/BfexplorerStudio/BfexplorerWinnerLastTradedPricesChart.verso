    {
      "id": "76c97dd1-d6e1-4cc5-9a66-4f7082250559",
      "type": "code",
      "language": "fsharp",
      "source": "#r \u0022nuget: Plotly.NET\u0022\r\n\r\n#I @\u0022E:\\Projects\\Bfexplorer\\Development\\Applications\\BeloSoft.Bfexplorer.App\\bin\\Debug\\net10.0-windows\u0022\r\n\r\n#r \u0022BeloSoft.Data.dll\u0022\r\n#r \u0022BeloSoft.Bfexplorer.Domain.dll\u0022\r\n#r \u0022BeloSoft.Bfexplorer.Service.Core.dll\u0022\r\n\r\nopen Plotly.NET\r\nopen System.Text.RegularExpressions\r\n\r\nopen BeloSoft.Bfexplorer.Domain\r\nopen BeloSoft.Bfexplorer.Service",
      "outputs": [
        {
          "mimeType": "text/html",
          "content": "\u003Cdiv\u003E\u003Cb\u003EInstalled Packages\u003C/b\u003E\u003Cul\u003E\u003Cli\u003E\u003Cspan\u003EPlotly.NET, 5.1.0\u003C/span\u003E\u003C/li\u003E\u003C/ul\u003E\u003C/div\u003E"
        }
