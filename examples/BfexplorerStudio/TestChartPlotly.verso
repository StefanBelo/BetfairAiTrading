    {
      "id": "ddf3ddcb-6cb0-4be3-bf70-3a70f5be920d",
      "type": "code",
      "language": "fsharp",
      "source": "#r \u0022nuget: Plotly.NET\u0022\r\n\r\nopen Plotly.NET\r\nopen System.Text.RegularExpressions\r\n\r\nlet x  = [for i in 0..20 -\u003E i]\r\nlet y = [for i in 0..20 -\u003E 2*i*2\u002B3*i\u002B10]\r\n\r\nlet chartHtml =\r\n    Chart.Line(x,y)\r\n    |\u003E Chart.withLayout(Layout.init(Width=500,Height=500))\r\n    |\u003E GenericChart.toEmbeddedHTML\r\n\r\nlet readyHtml =                                                                                                                                                                 \r\n    Regex.Replace(                                           \r\n        chartHtml,\r\n        @\u0022(renderPlotly_\\w\u002B)\\(\\);\u0022,\r\n        \u0022\u0022\u0022var render=$1;if(window.Plotly){render();}else{document.querySelector(\u0027script[src*=\u0022plotly\u0022]\u0027).addEventListener(\u0027load\u0027,render);}\u0022\u0022\u0022)  \r\n\r\ndisplayAs \u0022text/html\u0022 readyHtml",
      "outputs": [
        {
          "mimeType": "text/html",
          "content": "\u003Cdiv\u003E\u003Cb\u003EInstalled Packages\u003C/b\u003E\u003Cul\u003E\u003Cli\u003E\u003Cspan\u003EPlotly.NET, 5.1.0\u003C/span\u003E\u003C/li\u003E\u003C/ul\u003E\u003C/div\u003E"
        },
        {
          "mimeType": "text/html",
