  "cells": [
    {
      "id": "82fb6fd9-d5d2-4eaf-a886-a082ada7637f",
      "type": "code",
      "language": "fsharp",
      "source": "open System\n\ntype TimePriceVolume =\n    {\n        Time : DateTime\n        Price : float\n        Volume : float\n    }\n\nlet timePriceVolumes = [|\n    { \n        TimePriceVolume.Time = DateTime (2026, 4, 16, 8, 0, 0) \n        TimePriceVolume.Price = 2.0\n        TimePriceVolume.Volume = 100.0\n    }\n    { \n        TimePriceVolume.Time = DateTime (2026, 4, 16, 8, 10, 30) \n        TimePriceVolume.Price = 3.0\n        TimePriceVolume.Volume = 10.0\n    }\n    { \n        TimePriceVolume.Time = DateTime (2026, 4, 16, 8, 15, 50) \n        TimePriceVolume.Price = 6.0\n        TimePriceVolume.Volume = 50.0\n    }\n    { \n        TimePriceVolume.Time = DateTime (2026, 4, 16, 8, 30, 0) \n        TimePriceVolume.Price = 3.5\n        TimePriceVolume.Volume = 80.0\n    }        \n|]",
      "metadata": {
        "execution_count": 1
      }
    },
    {
      "id": "1fc65fbd-e8e6-4ec1-afe4-44e5aba37e5d",
      "type": "code",
      "language": "python",
      "source": "#!pip install seaborn pandas matplotlib\r\n\r\n\u0027\u0027\u0027\r\nimport sys\r\nimport subprocess\r\nimport importlib.util\r\n\r\nrequired_packages = [\u0022seaborn\u0022, \u0022pandas\u0022, \u0022matplotlib\u0022]\r\n\r\nfor package in required_packages:\r\n    if importlib.util.find_spec(package) is None:\r\n        # Use Windows cmd to run pip install\r\n        subprocess.check_call([\u0022cmd\u0022, \u0022/c\u0022, f\u0022pip install {package}\u0022])\r\n\u0027\u0027\u0027"
    },
    {
      "id": "a9f04773-3376-4b16-a235-83e5d09e097d",
      "type": "code",
      "language": "python",
      "source": "import pandas as pd\nfrom datetime import datetime\n\ndf = pd.DataFrame([\n    {\n        \u0022Time\u0022: datetime(\n            tpv.Time.Year,\n            tpv.Time.Month,\n            tpv.Time.Day,\n            tpv.Time.Hour,\n            tpv.Time.Minute,\n            tpv.Time.Second,\n            tpv.Time.Millisecond * 1000\n        ),\n        \u0022Price\u0022: tpv.Price,\n        \u0022Volume\u0022: tpv.Volume\n    }\n    for tpv in timePriceVolumes\n])\n\ndf",
      "outputs": [
        {
          "mimeType": "text/html",
          "content": "\u003Cdiv\u003E\n\u003Cstyle scoped\u003E\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n\u003C/style\u003E\n\u003Ctable border=\u00221\u0022 class=\u0022dataframe\u0022\u003E\n  \u003Cthead\u003E\n    \u003Ctr style=\u0022text-align: right;\u0022\u003E\n      \u003Cth\u003E\u003C/th\u003E\n      \u003Cth\u003ETime\u003C/th\u003E\n      \u003Cth\u003EPrice\u003C/th\u003E\n      \u003Cth\u003EVolume\u003C/th\u003E\n    \u003C/tr\u003E\n  \u003C/thead\u003E\n  \u003Ctbody\u003E\n    \u003Ctr\u003E\n      \u003Cth\u003E0\u003C/th\u003E\n      \u003Ctd\u003E2026-04-16 08:00:00\u003C/td\u003E\n      \u003Ctd\u003E2.0\u003C/td\u003E\n      \u003Ctd\u003E100.0\u003C/td\u003E\n    \u003C/tr\u003E\n    \u003Ctr\u003E\n      \u003Cth\u003E1\u003C/th\u003E\n      \u003Ctd\u003E2026-04-16 08:10:30\u003C/td\u003E\n      \u003Ctd\u003E3.0\u003C/td\u003E\n      \u003Ctd\u003E10.0\u003C/td\u003E\n    \u003C/tr\u003E\n    \u003Ctr\u003E\n      \u003Cth\u003E2\u003C/th\u003E\n      \u003Ctd\u003E2026-04-16 08:15:50\u003C/td\u003E\n      \u003Ctd\u003E6.0\u003C/td\u003E\n      \u003Ctd\u003E50.0\u003C/td\u003E\n    \u003C/tr\u003E\n    \u003Ctr\u003E\n      \u003Cth\u003E3\u003C/th\u003E\n      \u003Ctd\u003E2026-04-16 08:30:00\u003C/td\u003E\n      \u003Ctd\u003E3.5\u003C/td\u003E\n      \u003Ctd\u003E80.0\u003C/td\u003E\n    \u003C/tr\u003E\n  \u003C/tbody\u003E\n\u003C/table\u003E\n\u003C/div\u003E"
        }
      ]
    },
    {
      "id": "25c39228-d6e1-414f-b7bf-77bde5d09801",
      "type": "code",
      "language": "python",
      "source": "# Chart test \r\nimport seaborn as sns\r\nimport matplotlib.pyplot as plt\r\n\r\nsns.set_theme(style=\u0022whitegrid\u0022)\r\nfig, (ax1, ax2) = plt.subplots(2, 1, sharex=True, figsize=(10, 6), gridspec_kw={\u0022height_ratios\u0022: [3, 1]})\r\n\r\nsns.lineplot(data=df, x=\u0022Time\u0022, y=\u0022Price\u0022, marker=\u0022o\u0022, ax=ax1, label=\u0022Price\u0022)\r\nax2.bar(df[\u0022Time\u0022], df[\u0022Volume\u0022], width=0.003, color=\u0022skyblue\u0022, align=\u0022center\u0022)\r\n\r\nax1.set_title(\u0022Time vs Price\u0022)\r\nax1.set_ylabel(\u0022Price\u0022)\r\nax2.set_title(\u0022Volume\u0022)\r\nax2.set_ylabel(\u0022Volume\u0022)\r\nax2.set_xlabel(\u0022Time\u0022)\r\n\r\nfig.autofmt_xdate()\r\nplt.tight_layout()\r\nplt.show()",
      "outputs": [
