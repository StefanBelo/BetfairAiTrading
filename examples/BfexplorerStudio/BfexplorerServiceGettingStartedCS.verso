    {
      "id": "b0fbb8ab-e800-416b-9940-c76cf0d236d8",
      "type": "markdown",
      "source": "# Betfair Market Data Retrieval Example\n\nThis notebook demonstrates how to use bfexplorer and Betfair API assemblies in C# to:\n\n- Load required .NET assemblies for Betfair integration.\n- Retrieve and display the user\u0027s Betfair account balance.\n- Identify the active market (e.g., Ayr 17th Apr - 14:45 2m Hcap Hrd).\n- Fetch and display market data, including odds and available liquidity for each runner.\n\nThis workflow provides a foundation for automating Betfair market analysis and trading tasks using C#."
    },
    {
      "id": "f3c426ed-932b-4546-bc4f-a130c6278cd8",
      "type": "code",
      "language": "csharp",
      "source": "#r \u0022E:/Projects/Bfexplorer/Development/Applications/BeloSoft.Bfexplorer.App/bin/Debug/net10.0-windows/BeloSoft.Data.dll\u0022\r\n#r \u0022E:/Projects/Bfexplorer/Development/Applications/BeloSoft.Bfexplorer.App/bin/Debug/net10.0-windows/BeloSoft.Betfair.API.dll\u0022\r\n#r \u0022E:/Projects/Bfexplorer/Development/Applications/BeloSoft.Bfexplorer.App/bin/Debug/net10.0-windows/BeloSoft.Bfexplorer.API.dll\u0022\r\n#r \u0022E:/Projects/Bfexplorer/Development/Applications/BeloSoft.Bfexplorer.App/bin/Debug/net10.0-windows/BeloSoft.Bfexplorer.Host.dll\u0022\r\n#r \u0022E:/Projects/Bfexplorer/Development/Applications/BeloSoft.Bfexplorer.App/bin/Debug/net10.0-windows/BeloSoft.Bfexplorer.Domain.dll\u0022\r\n#r \u0022E:/Projects/Bfexplorer/Development/Applications/BeloSoft.Bfexplorer.App/bin/Debug/net10.0-windows/BeloSoft.Bfexplorer.Service.Core.dll\u0022\r\n#r \u0022E:/Projects/Bfexplorer/Development/Applications/BeloSoft.Bfexplorer.App/bin/Debug/net10.0-windows/BeloSoft.Bfexplorer.Service.dll\u0022\r\n#r \u0022E:/Projects/Bfexplorer/Development/Applications/BeloSoft.Bfexplorer.App/bin/Debug/net10.0-windows/BeloSoft.Bfexplorer.Interoperability.dll\u0022\r\n\r\nusing BeloSoft.Bfexplorer;\r\nusing BeloSoft.Bfexplorer.Domain;\r\nusing BeloSoft.Bfexplorer.Interoperability;\r\nusing BeloSoft.Bfexplorer.Service;\r\nusing BeloSoft.Data;\r\nusing Microsoft.FSharp.Core;\r\nusing System;\r\nusing System.Threading.Tasks;\r\n\r\n(string UserName, string Password)? GetUserNameAndPassword()\r\n{\r\n    var result = EnvironmentExtensions.GetMyBetfairCredentials();\r\n\r\n    if (FSharpOption\u003CTuple\u003Cstring, string\u003E\u003E.get_IsSome(result))\r\n    {\r\n        var credentials = result.Value;\r\n\r\n        return (credentials.Item1, credentials.Item2);\r\n    }\r\n    else\r\n    {\r\n        return null;\r\n    }\r\n}\r\n\r\n// Initialize bfexplorer service\r\nvar bfexplorerService = new BfexplorerService(initializeBotManager: false)\r\n{\r\n\tUiApplication = new BfexplorerHost(useMarketStreaming: false)\r\n};\r\n\r\nvar credentials = GetUserNameAndPassword();\r\n\r\nif (credentials != null)\r\n{\r\n\tvar loginResult = await bfexplorerService.Login(credentials?.UserName, credentials?.Password).ExecuteAsyncTask();\r\n\r\n\tif (loginResult.IsSuccess)\r\n\t{\r\n\t\tvar resultAccountFunds = await bfexplorerService.GetAccountFunds().ExecuteAsyncTask();\r\n\r\n\t\tif (resultAccountFunds.IsSuccess)\r\n\t\t{\r\n\t\t\tConsole.WriteLine($\u0022My account balance {resultAccountFunds.SuccessResult.AvailableToBetBalance:F2}\\n\u0022);\r\n\t\t}\r\n\t\telse\r\n\t\t{\r\n\t\t\tConsole.WriteLine($\u0022Failed to GetAccountFunds: {resultAccountFunds.FailureMessage}\u0022);\r\n\t\t}\r\n\t}\r\n\telse\r\n\t{\r\n\t\tConsole.WriteLine($\u0022Failed to login: {loginResult.FailureResult.Item3}\u0022);\r\n\t}\r\n}\r\nelse\r\n{\r\n\tConsole.WriteLine(\u0022Please set your credentials to the enviroment variables: BETFAIR_USERNAME, BETFAIR_PASSWORD.\u0022);\r\n}\r\n\r\nstring marketId = string.Empty;\r\n\r\nasync Task\u003CDataResult\u003CMarketResult\u003E\u003E GetActiveMarketAsync()\r\n{\r\n\tvar bfexplorerApplication = Services.CreateBfexplorerApplicationClient();\r\n    \r\n\ttry\r\n\t{\r\n\t\tvar marketResult = await bfexplorerApplication.GetActiveMarket();\r\n\r\n\t\treturn DataResult\u003CMarketResult\u003E.NewSuccess(marketResult);\r\n\t}\r\n\tcatch (Exception ex)\r\n\t{\r\n\t\treturn DataResult\u003CMarketResult\u003E.NewFailure(ex.Message);\r\n\t}\r\n}\r\n\r\nvar activeMarketResult = await GetActiveMarketAsync();\r\n\r\nif (activeMarketResult.IsSuccess)\r\n{\r\n\tmarketId = activeMarketResult.SuccessResult.MarketId;\r\n\r\n\t//Variables.Set(\u0022marketId\u0022, marketId);\r\n\tConsole.WriteLine($\u0022The active market in bfexplorer: {marketId}\u0022);\r\n}\r\nelse\r\n{\r\n\tConsole.WriteLine($\u0022Error: {activeMarketResult.FailureMessage}\u0022);\r\n}\r\n\r\nvoid ShowMarket(Market market)\r\n{\r\n\tConsole.WriteLine($\u0022{market.MarketFullName}\\n\u0022);\r\n\r\n\tvar selections = MarketExtensionsModule.getActiveSelections(market);\r\n\t\r\n\tforeach (var selection in selections)\r\n\t{\r\n\t\tConsole.WriteLine($\u0022{selection.Name} ~ {selection.LastPriceTraded:F2} | {selection.TotalMatched:F2}\u0022);\r\n\t}\r\n}\r\n\r\nConsole.WriteLine($\u0022Get market data for: {marketId}\u0022);\r\n\r\nMarket market = null;\r\n\r\nvar marketResult = await bfexplorerService.GetMarket(marketId, loadSelectionMetaData:false).ExecuteAsyncTask();\r\n\r\nif (marketResult.IsSuccess)\r\n{\r\n\tmarket = marketResult.SuccessResult;\r\n\r\n\t//Variables.Set(\u0022myMarket\u0022, market);\r\n\tShowMarket(market);\r\n}\r\nelse\r\n{\r\n\tConsole.WriteLine($\u0022Failed to get market: {marketResult.FailureMessage}\u0022);\r\n}\r\n\r\nvar updateResult = await bfexplorerService.UpdateMarket(market).ExecuteAsyncTask();\r\n\r\nif (updateResult.IsSuccess)\r\n{\r\n\tShowMarket(market);\r\n}\r\nelse\r\n{\r\n\tConsole.WriteLine($\u0022Failed to update market: {updateResult.FailureMessage}\u0022);\r\n}",
      "outputs": [
        {
          "mimeType": "text/plain",
          "content": "My account balance 467,68\n\r\nThe active market in bfexplorer: 1.256853532\r\nGet market data for: 1.256853532\r\nAyr 17th Apr - 14:45 2m Hcap Hrd\n\r\nCastle Ivers ~ 5,50 | 10025,23\r\nLance Les Des ~ 7,00 | 6500,24\r\nTriple Crown Ted ~ 7,60 | 6548,93\r\nSecret Force ~ 9,80 | 11967,72\r\nBibe Mus ~ 13,00 | 2816,09\r\nThe Gray Ghost ~ 15,00 | 2270,44\r\nNewtown Rambler ~ 16,00 | 1365,73\r\nMagna Victor ~ 17,00 | 2235,90\r\nCaballo De Guerra ~ 19,00 | 1471,97\r\nBerties Ballet ~ 23,00 | 1382,72\r\nTuppence ~ 38,00 | 1570,10\r\nGinger Mail ~ 46,00 | 790,19\r\nRavenscraig Castle ~ 44,00 | 744,07\r\nBelaya River ~ 75,00 | 457,75\r\nDance Thief ~ 95,00 | 368,36\r\nAyr 17th Apr - 14:45 2m Hcap Hrd\n\r\nCastle Ivers ~ 5,50 | 10025,23\r\nLance Les Des ~ 7,00 | 6500,24\r\nTriple Crown Ted ~ 7,60 | 6548,93\r\nSecret Force ~ 9,80 | 11967,72\r\nBibe Mus ~ 13,00 | 2816,09\r\nThe Gray Ghost ~ 15,00 | 2270,44\r\nNewtown Rambler ~ 16,00 | 1365,73\r\nMagna Victor ~ 17,00 | 2235,90\r\nCaballo De Guerra ~ 19,00 | 1471,97\r\nBerties Ballet ~ 23,00 | 1382,72\r\nTuppence ~ 38,00 | 1570,10\r\nGinger Mail ~ 46,00 | 790,19\r\nRavenscraig Castle ~ 44,00 | 744,07\r\nBelaya River ~ 75,00 | 457,75\r\nDance Thief ~ 95,00 | 368,36\r\n"
