  "cells": [
    {
      "id": "dbb2ed19-a034-406b-8302-8416f585bcb8",
      "type": "code",
      "language": "fsharp",
      "source": "#r \u0022nuget: Plotly.NET\u0022\r\n\r\n#I @\u0022E:\\Projects\\Bfexplorer\\Development\\Applications\\BeloSoft.Bfexplorer.App\\bin\\Debug\\net10.0-windows\u0022\r\n\r\n#r \u0022BeloSoft.Data.dll\u0022\r\n#r \u0022BeloSoft.Bfexplorer.Domain.dll\u0022\r\n#r \u0022BeloSoft.Bfexplorer.Service.Core.dll\u0022\r\n#r \u0022BeloSoft.Bfexplorer.AiTradingBots.Bot.dll\u0022\r\n\r\nopen Plotly.NET\r\nopen System.Text.RegularExpressions\r\n\r\nopen BeloSoft.Data\r\nopen BeloSoft.Bfexplorer.Domain\r\nopen BeloSoft.Bfexplorer.Service\r\n\r\nopen BeloSoft.Bfexplorer.AiTradingBots\r\nopen BeloSoft.Bfexplorer.DataAnalysis.AiModels",
      "outputs": [
        {
          "mimeType": "text/html",
          "content": "\u003Cdiv\u003E\u003Cb\u003EInstalled Packages\u003C/b\u003E\u003Cul\u003E\u003Cli\u003E\u003Cspan\u003EPlotly.NET, 5.1.0\u003C/span\u003E\u003C/li\u003E\u003C/ul\u003E\u003C/div\u003E"
        }
      ]
    },
    {
      "id": "e2029565-1910-436a-a70a-01674ea7632c",
      "type": "code",
      "language": "fsharp",
      "source": "let getFavouriteSelectionData (market : Market) = maybe {\r\n    let! selectionsData = market.GetData\u003CSelectionAiData list\u003E \u0022SelectionsData\u0022\r\n\r\n    return\r\n        selectionsData \r\n        |\u003E List.sortBy (fun selectionData -\u003E selectionData.Price)\r\n        |\u003E List.head\r\n}\r\n\r\nlet getSelectionDataByName name (market : Market) = maybe {\r\n    let! selectionsData = market.GetData\u003CSelectionAiData list\u003E \u0022SelectionsData\u0022\r\n\r\n    return!\r\n        selectionsData \r\n        |\u003E List.tryFind (fun selectionData -\u003E selectionData.Selection.Name = name)\r\n}\r\n    \r\nlet showChart (market : Market, dataSelectionAnalysis : SelectionAnalysisData seq) (name : string) = \r\n    let x, yPrices, yScores, yWomImbalances, yExecutionPressures, yLptvWallScales = \r\n        let startTime = market.MarketInfo.StartTime    \r\n\r\n        let x =\r\n            dataSelectionAnalysis \r\n            |\u003E Seq.map (fun data -\u003E (data.Time - startTime).TotalMinutes)\r\n            |\u003E Seq.toList\r\n\r\n        let yPrices, yScores = \r\n            dataSelectionAnalysis \r\n            |\u003E Seq.map (fun data -\u003E \r\n                    data.Price, data.Score \r\n                )\r\n            |\u003E Seq.toList        \r\n            |\u003E List.unzip\r\n\r\n        let yWomImbalances, yExecutionPressures, yLptvWallScales = \r\n            dataSelectionAnalysis \r\n            |\u003E Seq.map (fun data -\u003E \r\n                    let metrics = data.SelectionAnalysis.Metrics\r\n\r\n                    metrics.WomImbalance, metrics.ExecutionPressure, metrics.LptvWallScale \r\n                )\r\n            |\u003E Seq.toList        \r\n            |\u003E List.unzip3\r\n\r\n        x, yPrices, yScores, yWomImbalances, yExecutionPressures, yLptvWallScales\r\n\r\n    let combinedChartHtml =\r\n        [\r\n            Chart.Line (x, yPrices, Name = \u0022Price\u0022)\r\n            [\r\n                Chart.Line (x, yScores, Name = \u0022Score\u0022)\r\n                Chart.Line (x, [for _ in x -\u003E 0.08], Name = \u0022\u002B0.08 Threshold\u0022) |\u003E Chart.withLineStyle(Dash = StyleParam.DrawingStyle.Dash, Color = Color.fromKeyword ColorKeyword.Gray)\r\n                Chart.Line (x, [for _ in x -\u003E -0.08], Name = \u0022-0.08 Threshold\u0022) |\u003E Chart.withLineStyle(Dash = StyleParam.DrawingStyle.Dash, Color = Color.fromKeyword ColorKeyword.Gray)\r\n            ] |\u003E Chart.combine\r\n            Chart.Line (x, yWomImbalances, Name = \u0022WoM Imbalance\u0022)\r\n            Chart.Line (x, yExecutionPressures, Name = \u0022Execution Pressure\u0022)\r\n            Chart.Line (x, yLptvWallScales, Name = \u0022LPTV Wall Scale\u0022)\r\n        ]\r\n        |\u003E Chart.SingleStack()\r\n        |\u003E Chart.withLayout(Layout.init(Width = 1300, Height = 1000, HoverMode = StyleParam.HoverMode.XUnified))\r\n        |\u003E Chart.withShape(\r\n                LayoutObjects.Shape.init(\r\n                    ShapeType = StyleParam.ShapeType.Rectangle,\r\n                    Xref = \u0022paper\u0022, X0 = 0.0, X1 = 1.0,\r\n                    Yref = \u0022y2\u0022, Y0 = -0.08, Y1 = 0.08,\r\n                    FillColor = Color.fromKeyword ColorKeyword.LightGreen,\r\n                    Opacity = 0.2,\r\n                    Line = Line.init(Width = 0.0)\r\n                )\r\n            )\r\n        |\u003E Chart.withTitle(name)\r\n        |\u003E Chart.withXAxisStyle(\u0022Time (minutes)\u0022, ShowSpikes = true)\r\n        |\u003E Chart.withYAxisStyle(\u0022Price\u0022, Id = StyleParam.SubPlotId.YAxis 1)\r\n        |\u003E Chart.withYAxisStyle(\u0022Score\u0022, Id = StyleParam.SubPlotId.YAxis 2)\r\n        |\u003E Chart.withYAxisStyle(\u0022WoM Imbalance\u0022, Id = StyleParam.SubPlotId.YAxis 3)\r\n        |\u003E Chart.withYAxisStyle(\u0022Execution Pressure\u0022, Id = StyleParam.SubPlotId.YAxis 4)\r\n        |\u003E Chart.withYAxisStyle(\u0022LPTV Wall Scale\u0022, Id = StyleParam.SubPlotId.YAxis 5)        \r\n        |\u003E GenericChart.toEmbeddedHTML\r\n\r\n    let readyHtml =                                                                                                                                                                 \r\n        Regex.Replace(                                           \r\n            combinedChartHtml,\r\n            @\u0022(renderPlotly_\\w\u002B)\\(\\);\u0022,\r\n            \u0022\u0022\u0022var render=$1;if(window.Plotly){render();}else{document.querySelector(\u0027script[src*=\u0022plotly\u0022]\u0027).addEventListener(\u0027load\u0027,render);}\u0022\u0022\u0022)  \r\n\r\n    displayAs \u0022text/html\u0022 readyHtml"
    },
    {
      "id": "dabfe72f-a61a-4064-8358-8e4c258eb279",
      "type": "code",
      "language": "fsharp",
      "source": "let doShowSelectionChart (market : Market, selection : Selection) =\r\n    getSelectionDataByName selection.Name market\r\n    |\u003E Option.iter (fun selectionData -\u003E showChart (market, selectionData.DataSelectionAnalysis) selection.Name)"
    },
    {
      "id": "2647c28b-0ab5-43be-b09e-cc78cfd9787c",
      "type": "code",
      "language": "fsharp",
      "source": "let doShowSelectionTradeChart (market : Market, selection : Selection) =\r\n    selection.GetData\u003CResizeArray\u003CSelectionAnalysisData\u003E\u003E \u0022TradingData\u0022\r\n    |\u003E Option.iter (fun dataSelectionAnalysis -\u003E showChart (market, dataSelectionAnalysis) (sprintf \u0022%s - Trade\u0022 selection.Name))"
    },
    {
      "id": "8553cb0a-252f-4f41-8e4f-1b63985e92c9",
      "type": "code",
      "language": "fsharp",
      "source": "let doShowActiveSelectionChart (iBfexplorerConsole : IBfexplorerConsole) =\r\n    let market = iBfexplorerConsole.ActiveMarket\r\n    let selection = iBfexplorerConsole.ActiveSelection\r\n    \r\n    doShowSelectionTradeChart (market, selection)\r\n    doShowSelectionChart (market, selection)"
    },
    {
      "id": "fc87e5f4-51e9-47b6-ade4-0737cf493aa6",
      "type": "code",
      "language": "fsharp",
      "source": "doShowActiveSelectionChart (bfexplorerHost :\u003E IBfexplorerConsole)",
